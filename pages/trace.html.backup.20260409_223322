                                    查询
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card trace-flow-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-route"></i>
                            追溯轨迹
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="trace-flowchart">
                            <!-- 第一行流程 -->
                            <div class="flow-row">
                                <!-- 生产出厂节点 -->
                                <div class="flow-node">
                                    <div class="flow-node-header">
                                        <div class="flow-node-icon factory">
                                            <i class="fas fa-industry"></i>
                                        </div>
                                        <div class="flow-node-title">生产出厂</div>
                                        <div class="flow-node-status completed">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                    </div>
                                    <div class="flow-node-body">
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-clock"></i>时间</span>
                                            <span class="flow-value">2023-06-15 08:00</span>
                                        </div>
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-building"></i>厂家</span>
                                            <span class="flow-value">山东威高集团</span>
                                        </div>
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-barcode"></i>批次</span>
                                            <span class="flow-value code">WH20230615001</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- 流程连接线 -->
                                <div class="flow-connector">
                                    <div class="flow-line"></div>
                                    <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
                                </div>
                                
                                <!-- 入库节点 -->
                                <div class="flow-node">
                                    <div class="flow-node-header">
                                        <div class="flow-node-icon inbound">
                                            <i class="fas fa-warehouse"></i>
                                        </div>
                                        <div class="flow-node-title">入库</div>
                                        <div class="flow-node-status completed">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                    </div>
                                    <div class="flow-node-body">
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-clock"></i>时间</span>
                                            <span class="flow-value">2023-06-20 14:30</span>
                                        </div>
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-hospital"></i>科室</span>
                                            <span class="flow-value">药库</span>
                                        </div>
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-user"></i>操作人</span>
                                            <span class="flow-value">张三</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- 流程连接线 -->
                                <div class="flow-connector">
                                    <div class="flow-line"></div>
                                    <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
                                </div>
                                
                                <!-- 出库节点 -->
                                <div class="flow-node current">
                                    <div class="flow-node-header">
                                        <div class="flow-node-icon outbound">
                                            <i class="fas fa-dolly"></i>
                                        </div>
                                        <div class="flow-node-title">出库</div>
                                        <div class="flow-node-status current">
                                            <span class="current-badge">当前</span>
                                        </div>
                                    </div>
                                    <div class="flow-node-body">
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-clock"></i>时间</span>
                                            <span class="flow-value">2023-07-01 09:15</span>
                                        </div>
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-hospital"></i>科室</span>
                                            <span class="flow-value">手术室</span>
                                        </div>
                                        <div class="flow-info-row">
                                            <span class="flow-label"><i class="fas fa-user"></i>操作人</span>
                                            <span class="flow-value">李四</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
