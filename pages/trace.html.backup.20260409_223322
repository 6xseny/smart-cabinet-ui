    <style>
        /* 追溯中心专用样式 - 横向流程图 */
        .trace-search-card {
            margin-bottom: var(--space-6);
        }
        
        .trace-flow-card {
            margin-top: var(--space-6);
        }
        
        /* 流程图容器 - 横向布局 */
        .trace-flowchart {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: var(--space-4) 0;
            gap: 0;
        }
        
        /* 流程行容器 */
        .flow-row {
            display: flex;
            flex-wrap: wrap;
            align-items: stretch;
            justify-content: center;
            gap: 0;
            width: 100%;
        }
        
        /* 连接线 - 横向，只保留箭头 */
        .flow-connector {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            position: relative;
        }
        
        .flow-line {
            display: none;
        }
        
        .flow-arrow {
            position: relative;
            color: var(--neon-cyan);
            font-size: 1rem;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(0, 191, 255, 0.2), rgba(157, 0, 255, 0.2));
            border: 1px solid rgba(0, 191, 255, 0.5);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(0, 191, 255, 0.4), inset 0 0 12px rgba(0, 191, 255, 0.15);
            animation: pulse-arrow 2s infinite;
        }
        
        @keyframes pulse-arrow {
            0%, 100% { 
                transform: scale(1);
                box-shadow: 0 0 12px rgba(0, 191, 255, 0.4), inset 0 0 12px rgba(0, 191, 255, 0.15);
            }
            50% { 
                transform: scale(1.1);
                box-shadow: 0 0 22px rgba(0, 191, 255, 0.6), inset 0 0 18px rgba(0, 191, 255, 0.25);
            }
        }
        
        @keyframes bounce-vertical {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(3px); }
        }
        
        @keyframes bounce-horizontal {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(3px); }
        }
        
        /* 流程节点 - 固定宽度 */
        .flow-node {
            width: 260px;
            min-width: 260px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
            margin-bottom: var(--space-2);
        }
        
        .flow-node:hover {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 25px rgba(0, 191, 255, 0.2);
            transform: translateY(-2px);
        }
        
        .flow-node.current {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 30px rgba(0, 191, 255, 0.3), inset 0 0 20px rgba(0, 191, 255, 0.05);
        }
        
        .flow-node.current::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
        }
        
        .flow-node-header {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding: var(--space-3) var(--space-4);
            background: linear-gradient(90deg, rgba(0, 191, 255, 0.05), transparent);
            border-bottom: 1px solid var(--border-color);
        }
        
        .flow-node-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            flex-shrink: 0;
        }
        
        .flow-node-icon.factory {
            background: linear-gradient(135deg, rgba(0, 191, 255, 0.2), rgba(0, 191, 255, 0.05));
            color: var(--neon-cyan);
            box-shadow: 0 0 15px rgba(0, 191, 255, 0.3);
        }
        
        .flow-node-icon.inbound {
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.2), rgba(0, 255, 136, 0.05));
            color: var(--success);
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.3);
        }
        
        .flow-node-icon.outbound {
            background: linear-gradient(135deg, rgba(255, 204, 0, 0.2), rgba(255, 204, 0, 0.05));
            color: var(--warning);
            box-shadow: 0 0 15px rgba(255, 204, 0, 0.3);
        }
        
        .flow-node-title {
            flex: 1;
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .flow-node-status {
            font-size: 1.125rem;
        }
        
        .flow-node-status.completed {
            color: var(--success);
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }
        
        .flow-node-status.current {
            color: var(--neon-cyan);
            text-shadow: 0 0 10px rgba(0, 191, 255, 0.5);
        }
        
        .current-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 2px 10px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--neon-cyan);
            background: linear-gradient(135deg, rgba(0, 191, 255, 0.2), rgba(157, 0, 255, 0.15));
            border: 1px solid rgba(0, 191, 255, 0.5);
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0, 191, 255, 0.3), inset 0 0 8px rgba(0, 191, 255, 0.1);
            animation: pulse-badge 2s infinite;
        }
        
        @keyframes pulse-badge {
            0%, 100% { 
                box-shadow: 0 0 10px rgba(0, 191, 255, 0.3), inset 0 0 8px rgba(0, 191, 255, 0.1);
            }
            50% { 
                box-shadow: 0 0 18px rgba(0, 191, 255, 0.5), inset 0 0 12px rgba(0, 191, 255, 0.2);
            }
        }
        
        .flow-node-body {
            padding: var(--space-3) var(--space-4);
        }
        
        .flow-info-row {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            padding: var(--space-1) 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.8125rem;
        }
        
        .flow-info-row:last-child {
            border-bottom: none;
        }
        
        .flow-label {
            display: flex;
            align-items: center;
            gap: var(--space-1);
            width: 70px;
            color: var(--text-secondary);
            flex-shrink: 0;
        }
        
        .flow-label i {
            width: 14px;
            color: var(--neon-cyan);
            text-align: center;
            font-size: 0.75rem;
        }
        
        .flow-value {
            flex: 1;
            color: var(--text-primary);
            font-weight: 500;
        }
        
        .flow-value.code {
            font-family: 'Courier New', monospace;
            color: var(--neon-cyan);
            background: rgba(0, 191, 255, 0.1);
            padding: var(--space-1) var(--space-2);
            border-radius: var(--radius-sm);
            font-size: 0.75rem;
        }
        
        /* 搜索框样式优化 */
        .trace-search .search-input-group.large {
            max-width: 600px;
            margin: 0 auto;
        }
        
        .trace-search .search-input-group.large .form-input {
            height: 52px;
            font-size: 1rem;
        }
        
        .trace-search .search-input-group.large .btn {
            height: 52px;
            padding: 0 var(--space-6);
        }
        
        /* 响应式：小屏幕时垂直布局 */
        @media (max-width: 1200px) {
            .flow-row {
                flex-direction: column;
                align-items: center;
            }
            
            .flow-connector {
                width: 100%;
                height: 40px;
                flex-direction: column;
            }
            
            .flow-connector .flow-arrow {
                position: relative;
                right: auto;
                bottom: auto;
                animation: pulse-arrow 2s infinite;
            }
            
            .flow-node {
                width: 100%;
                max-width: 400px;
            }
        }
    </style>
    
    <script>
        document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const parent = link.parentElement;
                parent.classList.toggle('active');
                const submenu = parent.querySelector('.submenu');
                submenu.classList.toggle('show');
            });
        });

        document.getElementById('menuToggle').addEventListener('click', () => {
            document.querySelector('.sidebar').classList.toggle('collapsed');
            document.querySelector('.main-content').classList.toggle('expanded');
        });
    </script>
</body>
