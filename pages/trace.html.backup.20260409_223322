                <div class="card trace-search-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-search"></i>
                            追溯查询
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="trace-search">
                            <div class="search-input-group large">
                                <input type="text" class="form-input" placeholder="请输入UDI码或追溯码">
                                <button class="btn btn-primary">
